<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dqn-network" id="dqnnw">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Dueling Attention DQN for short-term telescope scheduling (KM40)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Policy and target networks share this architecture. Target values follow double Q-learning; the replay buffer is prioritized by TD error." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#767676;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1320" height="22" as="geometry" />
        </mxCell>

        <mxCell id="input" value="&lt;b&gt;state&lt;/b&gt; s_t ∈ ℝ³²²&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[ t/T, ψ_t, ε_t, n_t/N ]&lt;br&gt;[ x_1,t , … , x_N,t ]&lt;br&gt;4 + 6×N = 322&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FB;strokeColor=#0F4D92;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="obs_enc" value="&lt;b&gt;Obs encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linear 4→64 · ReLU&lt;br&gt;Linear 64→128 · ReLU · LayerNorm&lt;br&gt;→ e_ψ (128-d)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F4D92;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="tgt_enc" value="&lt;b&gt;Target encoder&lt;/b&gt; (×N)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linear 6→64 · ReLU&lt;br&gt;Linear 64→128 · ReLU · LayerNorm&lt;br&gt;→ e_1 … e_N (128-d each)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F4D92;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="500" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="mha" value="&lt;b&gt;Multi-head attention&lt;/b&gt; (8 heads)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;query = e_ψ (telescope state)&lt;br&gt;key = value = [e_1 … e_N]&lt;br&gt;attn(Q,K,V) = softmax(QKᵀ/√d_k)·V&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0E2;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="resid" value="&lt;b&gt;Residual + LayerNorm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;h = LayerNorm(e_ψ + MHA(...))&lt;br&gt;h ∈ ℝ¹²⁸&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="210" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="vstream" value="&lt;b&gt;Value stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linear 128→128 · ReLU&lt;br&gt;Linear 128→1&lt;br&gt;V(s) — state value&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B64342;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="370" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="astream" value="&lt;b&gt;Advantage stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linear 128→256 · ReLU · Dropout&lt;br&gt;Linear 256→N&lt;br&gt;A(s,a) — per-target advantage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B64342;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="510" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="qcomb" value="&lt;b&gt;Q(s,a) = V + (A − Ā)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dueling combination&lt;br&gt;action values for a ∈ {1…N}&lt;br&gt;output i always refers to target i&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#B64342;fontSize=12;arcSize=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="370" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="mask" value="&lt;b&gt;Action mask + ε-greedy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mask infeasible targets&lt;br&gt;(window / slew / elevation)&lt;br&gt;ε: 0.9 → 0.05, restart 0.45&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#4D4D4D;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="540" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="env" value="&lt;b&gt;TelescopeEnv&lt;/b&gt; (MDP)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;visibility windows · slew model&lt;br&gt;multi-objective reward&lt;br&gt;53 targets + advance action&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FB;strokeColor=#0F4D92;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="tnet" value="&lt;b&gt;Target net&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;θ⁻&lt;br&gt;soft update τ=0.005&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="190" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Fixed-position state:&lt;/b&gt; each target keeps its own 6-dim block, so output i is always target i&lt;br&gt;&lt;b&gt;Dueling:&lt;/b&gt; V(s) is learned once per state while A(s,a) varies per target&lt;br&gt;&lt;b&gt;Masked actions:&lt;/b&gt; illegal observations (outside a window, or infeasible slew/elevation) are never proposed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="230" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.25;entryX=0;entryY=0.4;strokeColor=#0F4D92;" edge="1" parent="1" source="input" target="obs_enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.75;entryX=0;entryY=0.5;strokeColor=#0F4D92;" edge="1" parent="1" source="input" target="tgt_enc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.4;entryX=0;entryY=0.4;strokeColor=#0F4D92;" edge="1" parent="1" source="obs_enc" target="mha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.6;entryX=0;entryY=0.8;strokeColor=#0F4D92;" edge="1" parent="1" source="tgt_enc" target="mha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82B366;" edge="1" parent="1" source="mha" target="resid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=0.65;exitY=1;entryX=0.5;entryY=0;strokeColor=#B64342;" edge="1" parent="1" source="resid" target="vstream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=0.2;exitY=1;entryX=0;entryY=0.5;strokeColor=#B64342;" edge="1" parent="1" source="resid" target="astream">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="335" />
              <mxPoint x="770" y="335" />
              <mxPoint x="770" y="565" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.4;entryX=0;entryY=0.35;strokeColor=#B64342;" edge="1" parent="1" source="vstream" target="qcomb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.7;strokeColor=#B64342;" edge="1" parent="1" source="astream" target="qcomb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#4D4D4D;" edge="1" parent="1" source="qcomb" target="mask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="action a_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;exitX=0;exitY=0.7;entryX=1;entryY=0.35;strokeColor=#4D4D4D;fontSize=10;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mask" target="env">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1092" y="620" />
              <mxPoint x="1092" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="next state s_t+1, reward r_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;dashed=1;exitX=0;exitY=0.75;entryX=0.5;entryY=1;strokeColor=#767676;fontSize=10;fontColor=#767676;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env" target="input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="target values use θ⁻; θ⁻ ← τθ + (1−τ)θ⁻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;dashed=1;exitX=0;exitY=0.2;entryX=0.5;entryY=0;strokeColor=#4D4D4D;fontSize=10;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tnet" target="resid">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1092" y="160" />
              <mxPoint x="960" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>